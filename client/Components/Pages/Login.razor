@inject AuthService AuthService

<div class="login-screen">
    <div class="login-card">
        <div class="sidebar-brand">
            <img src="images/logo.png" alt="logo" />
            <span>DesktopManagerStock</span>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <EditForm Model="_form" OnValidSubmit="EntrarAsync">
            <div class="field">
                <label>Usuario</label>
                <InputText @bind-Value="_form.Username" disabled="@_cargando" />
            </div>
            <div class="field">
                <label>Contraseña</label>
                <InputText type="password" @bind-Value="_form.Password" disabled="@_cargando" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_cargando">
                @if (_cargando)
                {
                    <span class="spinner"></span> <span>Ingresando…</span>
                }
                else
                {
                    <span>Ingresar</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginForm _form = new();
    private bool _cargando;
    private string? _error;

    private async Task EntrarAsync()
    {
        _error = null;
        _cargando = true;
        try
        {
            await AuthService.LoginAsync(_form.Username, _form.Password);
        }
        catch (ApiException ex)
        {
            _error = ex.StatusCode == 401
                ? "Usuario o contraseña incorrectos."
                : ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor. Verificá tu conexión o la URL de la API en Configuración.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private class LoginForm
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
