@if (Show)
{
    <div class="modal-backdrop" tabindex="-1" autofocus @onkeydown="OnKeyDown" @onclick="() => OnCancel.InvokeAsync()">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@Title</h2>
            </div>
            <p>@Message</p>
            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="() => OnCancel.InvokeAsync()">Cancelar</button>
                <button class="@(Danger ? "btn btn-danger" : "btn btn-primary")" @onclick="() => OnConfirm.InvokeAsync()" disabled="@Cargando">
                    @(Cargando ? "Procesando…" : ConfirmText)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "¿Confirmás esta acción?";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Cargando { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !Cargando)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
