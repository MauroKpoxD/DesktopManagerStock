<div class="table-wrap">
    <table>
        <tbody>
            @for (int fila = 0; fila < Filas; fila++)
            {
                <tr>
                    @for (int col = 0; col < Columnas; col++)
                    {
                        <td><div class="skeleton-bar"></div></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public int Filas { get; set; } = 5;
    [Parameter] public int Columnas { get; set; } = 5;
}
