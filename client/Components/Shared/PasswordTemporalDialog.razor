@if (Show)
{
    <div class="modal-backdrop" tabindex="-1" autofocus @onkeydown="OnKeyDown">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Contraseña temporal generada</h2>
            </div>
            <p style="color: var(--text-muted);">
                Para <strong>@Username</strong>. Copiala y pasásela por un canal seguro — no se va a
                volver a mostrar, y se recomienda que la cambie apenas entre (Mi perfil → Cambiar contraseña).
            </p>
            <div class="field">
                <input type="text" readonly value="@Password" @onclick="SeleccionarTodo" />
            </div>
            @if (_copiado)
            {
                <div class="alert alert-success">Copiada al portapapeles.</div>
            }
            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="CopiarAsync">Copiar</button>
                <button class="btn btn-primary" @onclick="() => OnCerrar.InvokeAsync()">Listo</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCerrar { get; set; }

    private bool _copiado;

    protected override void OnParametersSet() => _copiado = false;

    private async Task CopiarAsync()
    {
        await Clipboard.Default.SetTextAsync(Password);
        _copiado = true;
    }

    private void SeleccionarTodo()
    {
        // El input es readonly; el clic solo sirve para que el usuario pueda
        // seleccionar el texto a mano si prefiere no usar el botón Copiar.
    }

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCerrar.InvokeAsync();
        }
    }
}
