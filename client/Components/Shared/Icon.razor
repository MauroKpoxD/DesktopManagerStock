@* Íconos SVG simples estilo línea, dibujados a mano (sin depender de fuentes de íconos
   externas ni de una librería con licencia que revisar). Se usan con <Icon Name="home" />. *@

<span class="@CssClass">
    @switch (Name)
    {
        case "home":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 11l9-8 9 8" />
                <path d="M5 10v10h5v-6h4v6h5V10" />
            </svg>
            break;
        case "box":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 7.5l-9-5-9 5 9 5 9-5z" />
                <path d="M3 7.5v8l9 5 9-5v-8" />
                <path d="M12 12.5v8" />
            </svg>
            break;
        case "refresh":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4v5h5" />
                <path d="M20 20v-5h-5" />
                <path d="M4.6 9A8 8 0 0118 6.3L20 9" />
                <path d="M19.4 15A8 8 0 016 17.7L4 15" />
            </svg>
            break;
        case "alert-triangle":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.5l9.5 16.5H2.5z" />
                <line x1="12" y1="9.5" x2="12" y2="14" />
                <line x1="12" y1="17" x2="12" y2="17.2" />
            </svg>
            break;
        case "bar-chart":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="20" x2="5" y2="12" />
                <line x1="12" y1="20" x2="12" y2="6" />
                <line x1="19" y1="20" x2="19" y2="15" />
            </svg>
            break;
        case "users":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="3.2" />
                <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                <circle cx="17.5" cy="9.5" r="2.3" />
                <path d="M15.3 14.3c2.4.4 4.2 2.5 4.2 5" />
            </svg>
            break;
        case "user":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            </svg>
            break;
        case "log-out":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 4H5a2 2 0 00-2 2v12a2 2 0 002 2h4" />
                <polyline points="16 16 21 11 16 6" />
                <line x1="21" y1="11" x2="9" y2="11" />
            </svg>
            break;
        case "check-circle":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <polyline points="8 12.5 10.8 15.3 16 9.5" />
            </svg>
            break;
        case "dollar-sign":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="2" x2="12" y2="22" />
                <path d="M17 6.5c0-1.9-2.2-3.5-5-3.5s-5 1.6-5 3.5 2.2 3 5 3.5 5 1.6 5 3.5-2.2 3.5-5 3.5-5-1.6-5-3.5" />
            </svg>
            break;
        case "trending-down":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 7 10 14 14 10 21 17" />
                <polyline points="21 10 21 17 14 17" />
            </svg>
            break;
        case "file-text":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2.5h8l4 4v15H6z" />
                <line x1="9" y1="12" x2="15" y2="12" />
                <line x1="9" y1="16" x2="15" y2="16" />
            </svg>
            break;
        case "plus":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            break;
        case "sun":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4.2" />
                <line x1="12" y1="2.5" x2="12" y2="5" />
                <line x1="12" y1="19" x2="12" y2="21.5" />
                <line x1="4.2" y1="4.2" x2="6" y2="6" />
                <line x1="18" y1="18" x2="19.8" y2="19.8" />
                <line x1="2.5" y1="12" x2="5" y2="12" />
                <line x1="19" y1="12" x2="21.5" y2="12" />
                <line x1="4.2" y1="19.8" x2="6" y2="18" />
                <line x1="18" y1="6" x2="19.8" y2="4.2" />
            </svg>
            break;
        case "moon":
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 14.5A8.5 8.5 0 1110 3.3a6.7 6.7 0 0010 11.2z" />
            </svg>
            break;
    }
</span>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = "nav-icon";
}
